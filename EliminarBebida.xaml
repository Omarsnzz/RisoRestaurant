<Window x:Class="Riso.EliminarBebida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quitar Bebida" Height="500" Width="500" 
        WindowStartupLocation="CenterScreen" Background="#FEFDF1">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ELIMINAR DE LA LISTA" Foreground="#8B6B3F" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <DataGrid x:Name="dgBebidas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderBrush="#D1A757">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding Costo}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Volver" Width="100" Height="35" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" Click="btnRegresar_Click"/>
            <Button Content="Eliminar" Width="120" Height="35" Background="#8B6B3F" Foreground="White" FontWeight="Bold" Click="btnBorrar_Click"/>
        </StackPanel>
    </Grid>
</Window>