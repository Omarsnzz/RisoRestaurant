<Window x:Class="Riso.Cuenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réso - Generar Cuenta" Height="900" Width="1350" 
        WindowStartupLocation="CenterScreen" Background="#FEFDF1">

    <Window.Resources>
        <Style x:Key="BotonDoradoElegant" TargetType="Button">
            <Setter Property="Background" Value="#D1A757"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonCafeElegant" TargetType="Button" BasedOn="{StaticResource BotonDoradoElegant}">
            <Setter Property="Background" Value="#8B6B3F"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <!-- Panel de Cobro -->
            <ColumnDefinition Width="1*"/>
            <!-- Panel de Historial -->
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- PANEL IZQUIERDO: PUNTO DE VENTA Y COBRO        -->
        <!-- ============================================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="RISO" Foreground="#8B6B3F" FontSize="35" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                <TextBlock Text="PUNTO DE VENTA" Foreground="#D1A757" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="Folio:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                <TextBox x:Name="txtIdCuenta" Width="50" Margin="0,0,20,0" Padding="5" FontSize="14" IsReadOnly="True" Background="#EEEEEE"/>

                <TextBlock Text="Mesa:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                <TextBox x:Name="txtMesa" Width="80" Margin="0,0,20,0" Padding="5" FontSize="14"/>

                <TextBlock Text="Mesero:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                <TextBox x:Name="txtMesero" Width="200" Padding="5" FontSize="14"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#D1A757" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="rbAlimentos" Content="🍔 Alimentos" IsChecked="True" Checked="Filtro_Changed" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbBebidas" Content="🥤 Bebidas" Checked="Filtro_Changed" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,30,0"/>

                        <TextBlock Text="🔍 Buscar:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtBuscar" Width="300" Padding="5" FontSize="14" TextChanged="txtBuscar_TextChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="dgMenu" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="#FEFDF1" BorderBrush="#D1A757" FontSize="14" RowHeight="25" Margin="0,0,0,10">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#D1A757"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="100"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Cantidad:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtCantidad" Width="60" Margin="0,0,20,0" Padding="5" FontSize="14" Text="1" TextAlignment="Center"/>
                        <Button x:Name="btnAgregarLista" Content="➕ AGREGAR A LA CUENTA" Style="{StaticResource BotonDoradoElegant}" Width="220" Height="30" Click="btnAgregarLista_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid x:Name="dgCuenta" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White" BorderBrush="#D1A757" FontSize="14" RowHeight="30" SelectionChanged="dgCuenta_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#D1A757"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoBD}" Width="80"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"/>
                    <DataGridTextColumn Header="P. Unitario" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,10">
                <TextBlock Text="Cambiar Cantidad:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                <TextBox x:Name="txtEditarCantidad" Width="50" Margin="0,0,10,0" Padding="5" FontSize="14" TextAlignment="Center"/>
                <Button x:Name="btnActualizarCantidad" Content="✏️ ACTUALIZAR" Style="{StaticResource BotonDoradoElegant}" Width="130" Height="30" Margin="0,0,10,0" Click="btnActualizarCantidad_Click"/>
                <Button x:Name="btnEliminarArticulo" Content="🗑️ QUITAR" Style="{StaticResource BotonCafeElegant}" Width="100" Height="30" Click="btnEliminarArticulo_Click"/>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Descuentos:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,10,0" Width="85"/>
                        <Button x:Name="btnDesc10" Content="10%" Style="{StaticResource BotonCafeElegant}" Width="50" Height="30" Margin="0,0,5,0" Click="btnDesc10_Click"/>
                        <Button x:Name="btnDesc15" Content="15%" Style="{StaticResource BotonCafeElegant}" Width="50" Height="30" Margin="0,0,10,0" Click="btnDesc15_Click"/>

                        <TextBlock Text="Libre %:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtDescLibre" Width="40" Margin="0,0,5,0" Padding="2" FontSize="14" TextAlignment="Center"/>
                        <Button x:Name="btnDescLibre" Content="APLICAR" Style="{StaticResource BotonCafeElegant}" Width="80" Height="30" Margin="0,0,15,0" Click="btnDescLibre_Click"/>

                        <Button x:Name="btnQuitarDesc" Content="❌ QUITAR" Style="{StaticResource BotonCafeElegant}" Background="#C95B5B" Width="90" Height="30" Click="btnQuitarDesc_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Propina:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,10,0" Width="85"/>
                        <Button x:Name="btnPropina10" Content="10%" Style="{StaticResource BotonCafeElegant}" Width="50" Height="30" Margin="0,0,5,0" Click="btnPropina10_Click"/>
                        <Button x:Name="btnPropina15" Content="15%" Style="{StaticResource BotonCafeElegant}" Width="50" Height="30" Margin="0,0,5,0" Click="btnPropina15_Click"/>
                        <Button x:Name="btnPropina20" Content="20%" Style="{StaticResource BotonCafeElegant}" Width="50" Height="30" Margin="0,0,10,0" Click="btnPropina20_Click"/>

                        <TextBlock Text="Libre %:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtPropinaLibre" Width="40" Margin="0,0,5,0" Padding="2" FontSize="14" TextAlignment="Center"/>
                        <Button x:Name="btnPropinaLibre" Content="APLICAR" Style="{StaticResource BotonCafeElegant}" Width="80" Height="30" Margin="0,0,15,0" Click="btnPropinaLibre_Click"/>

                        <Button x:Name="btnQuitarPropina" Content="❌ QUITAR" Style="{StaticResource BotonCafeElegant}" Background="#C95B5B" Width="90" Height="30" Click="btnQuitarPropina_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#FFFBF0" BorderBrush="#D1A757" BorderThickness="2" CornerRadius="10" Padding="15" MinWidth="260">
                    <StackPanel>
                        <TextBlock x:Name="lblSubtotal" Text="Subtotal: $0.00" FontSize="15" FontWeight="SemiBold" Foreground="#8B6B3F" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblDescuento" Text="Descuento (0%): -$0.00" FontSize="14" Foreground="Red" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        <TextBlock x:Name="lblPropina" Text="Propina (0%): +$0.00" FontSize="14" Foreground="#4A90E2" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        <Separator Margin="0,5"/>
                        <TextBlock x:Name="lblTotal" Text="TOTAL: $0.00" FontSize="22" FontWeight="ExtraBold" Foreground="#634D2E" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="6" Columns="4" Margin="0,10,0,0" Height="50">
                <Button x:Name="btnGuardar" Content="💾 CREAR NUEVA" Style="{StaticResource BotonDoradoElegant}" Margin="5" Click="btnGuardar_Click"/>
                <Button x:Name="btnActualizar" Content="🔄 ACTUALIZAR" Style="{StaticResource BotonDoradoElegant}" Margin="5" Click="btnActualizar_Click" IsEnabled="False"/>
                <Button x:Name="btnLimpiar" Content="🧹 LIMPIAR TODO" Style="{StaticResource BotonCafeElegant}" Margin="5" Click="btnLimpiar_Click"/>
                <Button x:Name="btnVolver" Content="🏠 MENÚ" Style="{StaticResource BotonDoradoElegant}" Margin="5" Click="btnVolver_Click"/>
            </UniformGrid>
        </Grid>

        <!-- ============================================== -->
        <!-- PANEL DERECHO: HISTORIAL Y FILTRO DE FECHAS    -->
        <!-- ============================================== -->
        <Border Grid.Column="1" Background="#F9F4E8" BorderBrush="#D1A757" BorderThickness="1" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="HISTORIAL DE CUENTAS" FontWeight="Bold" FontSize="18" Foreground="#8B6B3F" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Filtrar por Fecha:" FontWeight="SemiBold" Foreground="#8B6B3F" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker x:Name="dpFiltroFecha" Width="130" Margin="0,0,10,0"/>
                        <Button Content="🔍 Buscar" Style="{StaticResource BotonDoradoElegant}" Width="80" Height="30" Click="btnBuscarFecha_Click"/>
                    </StackPanel>
                    <Button Content="📅 Mostrar las de Hoy" Style="{StaticResource BotonCafeElegant}" Height="30" Margin="0,10,0,0" Click="btnVerHoy_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgCuentasGuardadas" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White" BorderBrush="#D1A757" SelectionChanged="dgCuentasGuardadas_SelectionChanged" RowHeight="35">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#8B6B3F"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding idCuenta}" Width="40"/>
                        <DataGridTextColumn Header="Mesa" Binding="{Binding Mesa}" Width="60"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>