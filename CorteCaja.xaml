<Window x:Class="Riso.CorteCaja"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Cortes" Height="700" Width="550"
        WindowStartupLocation="CenterScreen" Background="#FDF8E1">

    <Grid>
        <Border Background="#634D2E" Height="180" VerticalAlignment="Top" CornerRadius="0,0,30,30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="REPORTE DE VENTAS" Foreground="#FDF8E1" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Riso Restaurante" Foreground="#C5A059" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,150,0,0" HorizontalAlignment="Center">
            <Border Background="White" CornerRadius="15" Padding="15" BorderBrush="#C5A059" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Seleccionar Fecha: " VerticalAlignment="Center" Foreground="#634D2E" FontWeight="Bold" Margin="0,0,10,0"/>
                    <DatePicker x:Name="dpFecha" Width="150" SelectedDateChanged="dpFecha_SelectedDateChanged" />
                </StackPanel>
            </Border>

            <Border Background="White" Width="400" Margin="0,20,0,0" CornerRadius="20" Padding="30" BorderBrush="#C5A059" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock x:Name="lblTituloFecha" Text="Corte del día: --/--/--" FontSize="18" FontWeight="Bold" Foreground="#8B6B3F" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Grid Margin="0,10">
                        <TextBlock Text="Ventas en Comedor" FontSize="16" Foreground="#634D2E"/>
                        <TextBlock x:Name="txtVentasRestaurante" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="#634D2E" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,10">
                        <TextBlock Text="Ventas a Domicilio" FontSize="16" Foreground="#634D2E"/>
                        <TextBlock x:Name="txtVentasDomicilio" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="#634D2E" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Background="#C5A059" Margin="0,15" Height="2"/>

                    <Grid>
                        <TextBlock Text="TOTAL NETO" FontSize="22" FontWeight="Black" Foreground="#634D2E"/>
                        <TextBlock x:Name="txtTotalGeneral" Text="$0.00" FontSize="24" FontWeight="Black" Foreground="#8B6B3F" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="btnVolver" Click="btnVolver_Click" Margin="0,40,0,0" Width="180" Height="45" Background="#634D2E" Foreground="White" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="← VOLVER" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Image Source="/res/img/InferiorIZQ.png" Width="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.5"/>
    </Grid>
</Window>