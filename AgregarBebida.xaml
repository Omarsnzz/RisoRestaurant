<Window x:Class="Riso.AgregarBebida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Bebida" Height="420" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#FEFDF1">

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="NUEVA BEBIDA" Foreground="#8B6B3F" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Nombre:" Foreground="#D1A757" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNombre" Height="35" BorderBrush="#D1A757" FontSize="16" Padding="5" Margin="0,0,0,20">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Precio ($):" Foreground="#D1A757" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPrecio" Height="35" BorderBrush="#D1A757" FontSize="16" Padding="5" Margin="0,0,0,35">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Button Content="GUARDAR EN MENÚ" Background="#D1A757" Foreground="White" Height="45" FontWeight="Bold" Click="btnGuardar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Cancelar" Background="Transparent" Foreground="#8B6B3F" Margin="0,15,0,0" Cursor="Hand" Click="btnRegresar_Click" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>