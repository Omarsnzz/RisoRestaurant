<Window x:Class="Riso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RisoRestaurant - Registro de Pedidos" Height="550" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5">

    <Grid Background="#F8F9FA">
        <StackPanel Margin="20">
            <TextBlock Text="RISORESTAURANT" 
                   FontSize="26" FontWeight="Bold" Foreground="#2C3E50" 
                   HorizontalAlignment="Center" Margin="0,20,0,40"/>

            <UniformGrid Columns="3" Rows="2" Height="300" VerticalAlignment="Center">
                <Button x:Name="btnPlatillos" Click="Menu_Click" Margin="10" Background="#3498DB" Foreground="White">
                    <Button.Content>
                        <StackPanel>
                            <TextBlock Text="Agregar Platillos" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="del día" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnInventario" Click="Menu_Click" Content="Inventario de mercancía" 
                    Margin="10" Background="#E67E22" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnPedidos" Click="Menu_Click" Margin="10" Background="#2ECC71" Foreground="White">
                    <Button.Content>
                        <TextBlock Text="Pedidos Domicilio / Para llevar" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                    </Button.Content>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnCuenta" Click="Menu_Click" Content="Generar cuenta" 
                    Margin="10" Background="#E74C3C" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnBebidas" Click="Menu_Click" Content="Bebidas" 
                    Margin="10" Background="#9B59B6" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>