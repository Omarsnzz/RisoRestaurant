<Window x:Class="Riso.PlatillosDia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réso - Platillos del Día" Height="650" Width="950" 
        WindowStartupLocation="CenterScreen" Background="#FEFDF1">

    <Window.Resources>
        <Style x:Key="BotonDoradoElegant" TargetType="Button">
            <Setter Property="Background" Value="#D1A757"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonCafeElegant" TargetType="Button" BasedOn="{StaticResource BotonDoradoElegant}">
            <Setter Property="Background" Value="#8B6B3F"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="RISO" Foreground="#8B6B3F" FontSize="40" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
            <TextBlock Text="PLATILLOS DEL DÍA" Foreground="#D1A757" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Nombre:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
            <TextBox x:Name="txtNombre" Width="200" Margin="0,0,20,0" Padding="5" FontSize="14"/>

            <TextBlock Text="Precio ($):" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
            <TextBox x:Name="txtPrecio" Width="100" Margin="0,0,20,0" Padding="5" FontSize="14"/>

            <TextBlock Text="Cantidad:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8B6B3F" Margin="0,0,5,0"/>
            <TextBox x:Name="txtCantidad" Width="100" Padding="5" FontSize="14"/>
        </StackPanel>

        <DataGrid x:Name="dgPlatillos" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" 
                  IsReadOnly="True" Background="White" BorderBrush="#D1A757" FontSize="15" RowHeight="35"
                  SelectionChanged="dgPlatillos_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#D1A757"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre del Platillo" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Precio ($)" Binding="{Binding Precio}" Width="150"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <UniformGrid Grid.Row="3" Columns="5" Margin="0,20,0,0" Height="50">
            <Button x:Name="btnAgregar" Content="➕ AGREGAR" Style="{StaticResource BotonDoradoElegant}" Margin="5" Click="btnAgregarPlatillo_Click"/>
            <Button x:Name="btnEditar" Content="✏️ EDITAR" Style="{StaticResource BotonDoradoElegant}" Margin="5" Click="btnEditarPlatillo_Click"/>
            <Button x:Name="btnEliminar" Content="🗑️ ELIMINAR" Style="{StaticResource BotonCafeElegant}" Margin="5" Click="btnEliminarPlatillo_Click"/>
            <Button x:Name="btnLimpiarTodo" Content="🧹 BORRAR TODO" Style="{StaticResource BotonCafeElegant}" Margin="5" Click="btnLimpiarTodo_Click"/>
            <Button x:Name="btnVolver" Content="🏠 MENÚ" Style="{StaticResource BotonDoradoElegant}" Margin="5" Click="btnVolver_Click"/>
        </UniformGrid>
    </Grid>
</Window>